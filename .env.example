# Postgres (Neon pooled connection string in production; local Docker for development)
DATABASE_URL=postgres://postgres:dev@localhost:54329/jobot

# Passcode for the dashboard (the site holds your CV, so it's private). Required in production.
ADMIN_PASSCODE=

# Gmail SMTP via an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_USER=you@gmail.com
SMTP_PASS=
NOTIFY_TO=you@gmail.com
# Dashboard URL, used for the link in the email
DASHBOARD_URL=https://your-project.vercel.app
# Without SMTP, MAIL_LOG=1 prints emails instead of sending them
# MAIL_LOG=1

# Apify (Google X-ray + Facebook groups). Free plan: $5 credit/month. Empty = those two sources are skipped.
APIFY_TOKEN=

# OPTIONAL: Claude scoring of jobs against the CV. Empty = free keyword scoring only.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5

# Tuning (defaults shown)
# MAX_QUERIES=8            search terms per source per run
# LINKEDIN_PAGES=2         10 jobs per page per query
# DETAILS_PER_SOURCE=25    full postings fetched per run for list-only sources
# STORE_MIN_SCORE=12       jobs below this match score aren't stored
# GOOGLE_MAX_QUERIES=6     Google X-ray queries per day
# FB_EVERY_DAYS=3          Facebook groups cadence
# FB_POSTS_PER_GROUP=4
